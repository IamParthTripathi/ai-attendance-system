# ============================================================
# AttendAI — .gitignore
# ============================================================

# ── Python ───────────────────────────────────────────────────
# Virtual environment — always exclude (huge, machine-specific)
ai-service/venv/
ai-service/.venv/

# Python cache files
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Generated face encodings (binary vectors, re-generated by encode_students.py)
ai-service/encodings/*.pkl

# Temporary upload folder used during AI processing
ai-service/temp_uploads/

# ── PHP / Backend ─────────────────────────────────────────────
# Classroom photos uploaded at runtime — not source code
backend/uploads/

# PHP environment file if you add one
.env
backend/.env

# ── Operating System ──────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# ── Editors & IDEs ────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/

# ── Sensitive config (never commit credentials) ───────────────
# If you ever add a secrets file, exclude it here:
secrets.php
config.local.php
